{
  "__inputs": [
    {
      "name": "DS_METRICS",
      "label": "Metrics",
      "description": "PMM VictoriaMetrics datasource (Metrics)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Firebird",
  "uid": "firebird-overview",
  "tags": [
    "firebird",
    "pmm"
  ],
  "timezone": "browser",
  "description": "Firebird 2.5 monitoring by Vladislav Sloboder, ArchiDB (https://archidb.de) - https://github.com/vladislavsloboder/firebird-exporter",
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "ArchiDB",
      "type": "link",
      "icon": "external link",
      "url": "https://archidb.de",
      "targetBlank": true
    },
    {
      "title": "firebird-exporter (GitHub)",
      "type": "link",
      "icon": "external link",
      "url": "https://github.com/vladislavsloboder/firebird-exporter",
      "targetBlank": true,
      "tooltip": "Source code and documentation"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service (Regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:20px;padding:8px 6px 12px 6px;border-bottom:2px solid rgba(128,128,128,.35);\">\n<a href=\"https://archidb.de\" target=\"_blank\" rel=\"noopener\" style=\"text-decoration:none;color:inherit;font-size:34px;letter-spacing:2px;line-height:1;white-space:nowrap;\">ARCHI<b>DB</b></a>\n<div style=\"flex:1;\">\n<div style=\"font-size:26px;font-weight:700;\">Firebird 2.5 Monitoring</div>\n<div style=\"opacity:.7;font-size:13px;margin-top:2px;\">Exporter &amp; dashboard by Vladislav Sloboder &middot; ArchiDB &middot; data from the MON$ monitoring tables via Percona PMM</div>\n</div>\n<a href=\"https://archidb.de\" target=\"_blank\" rel=\"noopener\" style=\"padding:8px 16px;border-radius:8px;border:1px solid currentColor;color:inherit;font-weight:600;text-decoration:none;white-space:nowrap;\">archidb.de</a>\n<a href=\"https://github.com/vladislavsloboder/firebird-exporter\" target=\"_blank\" rel=\"noopener\" style=\"padding:8px 16px;border-radius:8px;border:1px solid currentColor;color:inherit;font-weight:600;text-decoration:none;white-space:nowrap;\">GitHub &rarr;</a>\n</div>"
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Status",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Firebird",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "firebird_up{service_name=~\"$service\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Verbindungen",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 3,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "firebird_attachments_total{service_name=~\"$service\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Davon aktiv",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 6,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "firebird_attachments_active{service_name=~\"$service\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Aelteste aktive Tx",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 9,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "firebird_transaction_oldest_active_seconds{service_name=~\"$service\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Transaction Gap",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "firebird_transaction_gap{service_name=~\"$service\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10000
              },
              {
                "color": "red",
                "value": 100000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Cache-Hit-Ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 15,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (rate(firebird_page_reads_total{service_name=~\"$service\"}[$__rate_interval]) / clamp_min(rate(firebird_page_fetches_total{service_name=~\"$service\"}[$__rate_interval]), 1))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "Freier Plattenplatz",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 18,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * firebird_disk_free_bytes{service_name=~\"$service\"} / firebird_disk_total_bytes{service_name=~\"$service\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
